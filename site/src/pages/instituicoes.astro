---
import Base from "../layouts/Base.astro";
import { indice, enriquecimento, formatar, formatarMesPorExtenso, ligacao } from "../lib/dados";
import Abertura from "../components/Abertura.astro";
import Triagem from "../components/Triagem.astro";
import Europa from "../components/Europa.astro";
import Movimento from "../components/Movimento.astro";
import Tese from "../components/Tese.astro";

const lista = indice();

/* Rodapé da lista: quantas pessoas ficam sem médico de família atribuído. É o
   número que fecha a página, e agrega-se por soma dos numeradores sobre soma
   dos denominadores, como todo o resto — nunca pela média das percentagens. */
const pop = enriquecimento().populacao;
const semMedico = Object.values(pop.por_instituicao).reduce(
  (s, p) => s + p.sem_medico_familia,
  0,
);
const periodoPop = pop.periodo;

/* Os grupos da ACSS, para se poder entrar por cluster e não só por região. O
   dado já vinha no índice; faltava-lhe uma porta. */
const clusters = [...new Set(lista.map((i) => i.grupo_acss).filter(Boolean))].sort() as string[];
const contaCluster = Object.fromEntries(
  clusters.map((g) => [g, lista.filter((i) => i.grupo_acss === g).length]),
);

const porRegiao = [...new Set(lista.map((i) => i.regiao))].sort();
const regioes = porRegiao.map((r) => ({
  regiao: r,
  itens: lista
    .filter((i) => i.regiao === r)
    .sort((a, b) => a.nome_curto.localeCompare(b.nome_curto, "pt")),
}));

/* Filtros estruturados, a par do texto livre: região, natureza e grupo ACSS
   são as três formas de recortar a lista que o índice já conhece. Derivados
   dos dados — um tipo novo aparece aqui sem tocar nesta página. */
const ROTULO_TIPO: Record<string, string> = {
  uls: "ULS",
  oncologico: "Institutos de oncologia",
  ppp: "PPP",
};
const tipos = [...new Set(lista.map((i) => i.tipo))].sort();
---

<Base
  titulo="O SNS, hospital a hospital"
  descricao="Indicadores de acesso, qualidade, capacidade e contas de cada unidade de saúde do SNS, comparados com o país. Dados públicos, reorganizados por instituição."
>
  <Abertura />

  <Triagem />

  <Tese />

  <Europa />

  <section class="lista" id="achar">
    <div>
      <div class="sec-band"><h2>Encontre a sua unidade de saúde</h2><span class="ln" /><span class="n">{lista.length} unidades</span></div>

      {clusters.length > 0 && (
        <nav class="clusters" aria-label="Grupos de comparação da ACSS">
          <p class="flabel">
            Ou entre por grupo de comparação — as unidades que a ACSS considera
            semelhantes em custo, e que por isso se comparam entre si
          </p>
          <ul>
            {clusters.map((g) => (
              <li>
                <a href={ligacao(`/grupo/${g.replace(/^Grupo\s+/i, "").toLowerCase()}/`)}>
                  {g}<span class="clusters__n num">{contaCluster[g]}</span>
                </a>
              </li>
            ))}
            <li>
              <a href={ligacao("/grupo/")}>O que são os grupos →</a>
            </li>
          </ul>
        </nav>
      )}

      <p class="lista__intro">
        Escreva na caixa de procura lá em cima, ou aponte para um ponto do mapa:
        os dois filtram esta lista ao mesmo tempo.{" "}
        <strong class="num">{formatar(semMedico, "contagem")}</strong> pessoas
        inscritas no SNS não têm médico de família atribuído
        ({formatarMesPorExtenso(periodoPop)}).
      </p>

      {/* Filtros estruturados. Combinam-se entre si e com o texto livre, e o
          estado fica no endereço — «as unidades do Norte» passa a ser uma
          ligação que se envia, não uma sequência de gestos a repetir. Sem
          JavaScript não filtram nada, e por isso não aparecem. */}
      <div class="filtros" data-filtros>
        <div class="filtros__grupo" role="group" aria-label="Filtrar por região">
          <p class="flabel">Região</p>
          <div class="filtros__chips">
            {porRegiao.map((r) => (
              <button class="chip" type="button" data-filtro="regiao" data-valor={r} aria-pressed="false">
                {r}
              </button>
            ))}
          </div>
        </div>
        <div class="filtros__grupo" role="group" aria-label="Filtrar por natureza">
          <p class="flabel">Natureza</p>
          <div class="filtros__chips">
            {tipos.map((t) => (
              <button class="chip" type="button" data-filtro="tipo" data-valor={t} aria-pressed="false">
                {ROTULO_TIPO[t] ?? t}
              </button>
            ))}
          </div>
        </div>
        {clusters.length > 0 && (
          <div class="filtros__grupo" role="group" aria-label="Filtrar por grupo de comparação">
            <p class="flabel">Grupo ACSS</p>
            <div class="filtros__chips">
              {clusters.map((g) => (
                <button class="chip" type="button" data-filtro="grupo" data-valor={g} aria-pressed="false">
                  {g.replace(/^Grupo\s+/i, "")}
                </button>
              ))}
            </div>
          </div>
        )}
        <button class="filtros__limpar" type="button" data-limpar hidden>
          Limpar filtros
        </button>
      </div>

      {
        regioes.map((r) => (
          <div class="regiao" data-bloco data-entrada>
            <div class="sec-band"><h2>{r.regiao}</h2><span class="ln" /><span class="n">{r.itens.length} {r.itens.length === 1 ? "unidade" : "unidades"}</span></div>
            <ul class="regiao__lista">
              {r.itens.map((i) => (
                <li
                  data-item
                  data-busca={`${i.nome_curto} ${i.distrito} ${i.regiao} ${i.grupo_acss ?? ""}`.toLowerCase()}
                  data-regiao={i.regiao}
                  data-tipo={i.tipo}
                  data-grupo={i.grupo_acss ?? ""}
                >
                  <a href={ligacao(`/instituicao/${i.id}/`)}>
                    <span class="regiao__nome">{i.nome_curto}</span>
                    <span class="regiao__meta">
                      {i.distrito}
                      {i.grupo_acss && (
                        <>
                          <span aria-hidden="true"> · </span>
                          <span class="regiao__grupo">{i.grupo_acss}</span>
                        </>
                      )}
                      <span aria-hidden="true"> · </span>
                      <span class="num">{i.n_indicadores}</span> indicadores
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="lista__vazio" data-vazio hidden>
        Nenhuma unidade corresponde a essa procura.
      </p>
    </div>
  </section>
  <Movimento />
</Base>

<script>
  const campo = document.querySelector<HTMLInputElement>("[data-procura]");
  const itens = [...document.querySelectorAll<HTMLElement>("[data-item]")];
  // `[data-bloco]`, e não `[data-regiao]`: os pontos do mapa também levam
  // `data-regiao` para alimentar o mostrador, e o seletor antigo apanhava
  // 48 elementos — os 5 blocos mais as 43 unidades —, mandando esconder pontos
  // do mapa a cada tecla. Não se via porque `hidden` não é propriedade de
  // elementos SVG, mas a intenção do código era o contrário do que ele fazia.
  const regioes = [...document.querySelectorAll<HTMLElement>("[data-bloco]")];
  const pontos = [...document.querySelectorAll<SVGElement>("[data-ponto]")];
  const vazio = document.querySelector<HTMLElement>("[data-vazio]");
  const contagem = document.querySelector<HTMLElement>("[data-contagem]");
  const chips = [...document.querySelectorAll<HTMLButtonElement>("[data-filtro]")];
  const limpar = document.querySelector<HTMLButtonElement>("[data-limpar]");

  // Sem acentos: quem escreve «Tras-os-Montes» tem de encontrar o hospital.
  const semAcentos = (s: string) =>
    s.normalize("NFD").replace(/\p{Diacritic}/gu, "");

  /* O estado dos filtros. Uma escolha por dimensão, combinável com o texto —
     e espelhado no endereço, para que «as ULS do Norte» seja uma ligação que
     se envia e não uma sequência de gestos a repetir. */
  const estado = { q: "", regiao: "", tipo: "", grupo: "" };

  const corresponde = (d: DOMStringMap) => {
    if (estado.regiao && d.regiao !== estado.regiao) return false;
    if (estado.tipo && d.tipo !== estado.tipo) return false;
    if (estado.grupo && d.grupo !== estado.grupo) return false;
    if (estado.q === "") return true;
    return semAcentos(d.busca ?? "").includes(estado.q);
  };

  function aplicar(escreverUrl = true) {
    let visiveis = 0;
    for (const item of itens) {
      const mostra = corresponde(item.dataset);
      item.hidden = !mostra;
      if (mostra) visiveis++;
    }
    for (const r of regioes) {
      r.hidden = ![...r.querySelectorAll<HTMLElement>("[data-item]")].some(
        (i) => !i.hidden,
      );
    }
    // No mapa as que não correspondem são atenuadas, não escondidas: o país
    // tem de continuar reconhecível enquanto se escreve, senão a procura
    // desfaz a própria imagem que ajuda a orientar.
    for (const p of pontos) {
      if (corresponde(p.dataset)) p.removeAttribute("data-fora");
      else p.setAttribute("data-fora", "");
    }
    const aFiltrar =
      estado.q !== "" || estado.regiao !== "" || estado.tipo !== "" || estado.grupo !== "";
    if (vazio) vazio.hidden = visiveis > 0;
    if (contagem) {
      contagem.textContent = aFiltrar
        ? `${visiveis} ${visiveis === 1 ? "unidade" : "unidades"}`
        : "";
    }
    for (const c of chips) {
      c.setAttribute(
        "aria-pressed",
        String(estado[c.dataset.filtro as "regiao" | "tipo" | "grupo"] === c.dataset.valor),
      );
    }
    if (limpar) limpar.hidden = !aFiltrar;
    if (escreverUrl) {
      const p = new URLSearchParams();
      if (campo?.value.trim()) p.set("q", campo.value.trim());
      if (estado.regiao) p.set("regiao", estado.regiao);
      if (estado.tipo) p.set("tipo", estado.tipo);
      if (estado.grupo) p.set("grupo", estado.grupo);
      const query = p.toString();
      history.replaceState(null, "", query ? `?${query}` : location.pathname);
    }
  }

  campo?.addEventListener("input", () => {
    estado.q = semAcentos(campo.value.trim().toLowerCase());
    aplicar();
  });

  for (const c of chips) {
    c.addEventListener("click", () => {
      const dim = c.dataset.filtro as "regiao" | "tipo" | "grupo";
      estado[dim] = estado[dim] === c.dataset.valor ? "" : (c.dataset.valor ?? "");
      aplicar();
    });
  }

  limpar?.addEventListener("click", () => {
    estado.q = ""; estado.regiao = ""; estado.tipo = ""; estado.grupo = "";
    if (campo) campo.value = "";
    aplicar();
  });

  /* Chegada por ligação partilhada: o endereço reconstrói o estado. */
  {
    const p = new URLSearchParams(location.search);
    const q = p.get("q") ?? "";
    if (campo && q) campo.value = q;
    estado.q = semAcentos(q.trim().toLowerCase());
    for (const dim of ["regiao", "tipo", "grupo"] as const) {
      const v = p.get(dim);
      if (v && chips.some((c) => c.dataset.filtro === dim && c.dataset.valor === v)) {
        estado[dim] = v;
      }
    }
    if (estado.q || estado.regiao || estado.tipo || estado.grupo) aplicar(false);
  }

  /* ── o mostrador segue o mapa ──────────────────────────────────────────── */

  const mostrador = {
    rot: document.querySelector<HTMLElement>("[data-mostrador-rot]"),
    nome: document.querySelector<HTMLElement>("[data-mostrador-nome]"),
    pop: document.querySelector<HTMLElement>("[data-mostrador-pop]"),
    sm: document.querySelector<HTMLElement>("[data-mostrador-sm]"),
    ind: document.querySelector<HTMLElement>("[data-mostrador-ind]"),
  };
  // O estado de repouso é o que já está no HTML — guardá-lo evita recalcular
  // o resumo do país em JavaScript e mantém uma só fonte para esse número.
  const repouso = {
    rot: mostrador.rot?.textContent ?? "",
    nome: mostrador.nome?.textContent ?? "",
    pop: mostrador.pop?.textContent ?? "",
    sm: mostrador.sm?.textContent ?? "",
    ind: mostrador.ind?.textContent ?? "",
  };
  const nf = new Intl.NumberFormat("pt-PT");
  const nf1 = new Intl.NumberFormat("pt-PT", {
    minimumFractionDigits: 1,
    maximumFractionDigits: 1,
  });

  function mostrar(p: SVGElement | null) {
    if (!mostrador.nome) return;
    if (!p) {
      mostrador.rot!.textContent = repouso.rot;
      mostrador.nome.textContent = repouso.nome;
      mostrador.pop!.textContent = repouso.pop;
      mostrador.sm!.textContent = repouso.sm;
      mostrador.ind!.textContent = repouso.ind;
      return;
    }
    const pop = p.dataset.pop;
    const sm = p.dataset.semMedico;
    mostrador.rot!.textContent = `${p.dataset.distrito} · ${p.dataset.regiao}`;
    mostrador.nome.textContent = p.dataset.nome ?? "";
    mostrador.pop!.textContent = pop ? nf.format(Number(pop)) : "não publicada";
    mostrador.sm!.textContent = sm ? `${nf1.format(Number(sm))} %` : "—";
    mostrador.ind!.textContent = p.dataset.indicadores ?? "";
  }

  for (const p of pontos) {
    p.addEventListener("pointerenter", () => mostrar(p));
    p.addEventListener("focus", () => mostrar(p));
    p.addEventListener("pointerleave", () => mostrar(null));
    p.addEventListener("blur", () => mostrar(null));
  }
</script>

<style>
  .lista { padding-top: 6px; scroll-margin-top: 62px; }
  .lista__intro {
    margin: 14px 0 22px;
    font-size: var(--t-sm);
    color: var(--ink-2);
    max-width: 74ch;
  }
  .lista__intro strong { color: var(--ink); font-weight: 750; }

  /* Sem JavaScript os chips não filtram nada: não aparecem, como a procura. */
  :global(html:not(.js)) .filtros { display: none; }
  .filtros {
    display: grid; gap: 10px; margin: 0 0 26px; padding: 14px 0 16px;
    border-block: 1px solid var(--grid);
  }
  .filtros__grupo { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .filtros__grupo .flabel { flex: none; min-width: 7.5rem; margin: 0; }
  .filtros__chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .filtros__limpar {
    justify-self: start; margin-top: 2px;
    font: 600 var(--t-2xs)/1 system-ui, sans-serif;
    color: var(--muted); background: none; border: none;
    text-decoration: underline; cursor: pointer; padding: 4px 0;
    min-height: 24px;
  }
  .filtros__limpar:hover { color: var(--ink); }

  .regiao { margin-bottom: 8px; }
  .regiao__lista {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  }
  /* 43 ligações numa grelha: o que falta é saber qual está sob o cursor. Uma
     régua de acento cresce da esquerda no filete que já existe, e o nome
     avança com ela — dois píxeis, o suficiente para o olho seguir sem que a
     grelha pareça mexer. */
  .regiao__lista a {
    display: flex; flex-direction: column; gap: 2px; padding: 11px 12px 11px 0;
    text-decoration: none; border-bottom: 1px solid var(--grid); height: 100%;
    color: inherit; position: relative;
  }
  .regiao__lista a::after {
    content: ""; position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%;
    background: var(--accent); transform: scaleX(0); transform-origin: left;
    transition: transform 0.32s cubic-bezier(0.22, 0.8, 0.25, 1);
  }
  .regiao__lista a:hover::after,
  .regiao__lista a:focus-visible::after { transform: scaleX(1); }
  .regiao__nome { transition: transform 0.32s cubic-bezier(0.22, 0.8, 0.25, 1); }
  .regiao__lista a:hover .regiao__nome,
  .regiao__lista a:focus-visible .regiao__nome {
    color: var(--accent-texto); transform: translateX(2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .regiao__lista a::after, .regiao__nome { transition: none; }
    .regiao__lista a:hover .regiao__nome { transform: none; }
  }
  .regiao__nome { font-weight: 600; font-size: var(--t-sm); }
  .regiao__meta { font-size: var(--t-2xs); color: var(--muted); }
  .lista__vazio { color: var(--muted); }
  .clusters { margin: 8px 0 20px; }
  .clusters ul { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 0; padding: 0; }
  .clusters a {
    display: inline-flex; align-items: baseline; gap: 6px;
    padding: 6px 12px; border: 1px solid var(--border); border-radius: 999px;
    font-size: var(--t-2xs); text-decoration: none; color: var(--ink-2);
  }
  .clusters a:hover, .clusters a:focus-visible { border-color: var(--accent); color: var(--accent-texto); }
  .clusters__n { color: var(--muted); font-size: var(--t-3xs); }
  /* O grupo entra na linha de cada unidade e no texto de procura: escrever
     «grupo c» na caixa passa a filtrar o cluster. */
  .regiao__grupo { white-space: nowrap; }
</style>
