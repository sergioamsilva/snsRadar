---
/**
 * Entrada por pergunta, não por indicador.
 *
 * A ficha e o painel são vistas de analista: pressupõem que já se sabe que
 * indicador se procura. Quem vai ter um filho não procura «taxa de cesarianas
 * por instituição» — procura a maternidade onde vai ser atendido.
 *
 * Cada pergunta é respondida com as unidades do distrito escolhido, e não com
 * um ranking nacional: a escolha real de um doente é entre os hospitais que
 * lhe ficam perto.
 */
import Base from "../layouts/Base.astro";
import { indice, ficha, nacional, formatar, ligacao } from "../lib/dados";
import Movimento from "../components/Movimento.astro";
import Icone from "../components/Icone.astro";

const nac = nacional();
const todas = indice().map((i) => ficha(i.id));

const PERGUNTAS = [
  {
    id: "maternidade",
    icone: "nascimento",
    atalho: "Maternidade",
    pergunta: "Vou ter um bebé. Que maternidade?",
    indicador: "cesarianas",
    explica:
      "A proporção de partos por cesariana varia muito entre maternidades, e nem toda essa variação se explica pelo risco das grávidas que cada uma recebe.",
    cautela:
      "Uma taxa mais alta não significa pior cuidado: maternidades que recebem gravidezes de alto risco operam mais, e com razão. Serve para perguntar, não para escolher sozinho.",
  },
  {
    id: "cirurgia",
    icone: "relogio",
    atalho: "Cirurgia",
    pergunta: "Vou ser operado. Quanto tempo espero?",
    indicador: "lic-dentro-tmrg",
    explica:
      "Percentagem de doentes em lista de espera cirúrgica cuja espera ainda não ultrapassou o prazo legal. Mais alto é melhor.",
    cautela:
      "Estar «dentro do prazo» não significa ter sido operado — significa que o tempo máximo garantido ainda não foi excedido.",
  },
  {
    id: "urgencia",
    icone: "pulso",
    atalho: "Urgência",
    pergunta: "Preciso de ir à urgência.",
    indicador: "urgencia-prioritarios",
    explica:
      "Proporção de atendimentos classificados como emergentes ou muito urgentes na triagem de Manchester.",
    cautela:
      "Não é uma medida de espera nem de qualidade: uma proporção alta pode indicar boa filtragem da procura não urgente, ou uma população mais doente. Para saber a espera de agora, consulte o portal oficial de tempos de espera.",
  },
] as const;

/** Unidades por distrito, com o valor de cada pergunta. */
const distritos = [...new Set(todas.map((f) => f.distrito))].sort((a, b) =>
  a.localeCompare(b, "pt"),
);

const dados = distritos.map((distrito) => ({
  distrito,
  unidades: todas
    .filter((f) => f.distrito === distrito)
    .map((f) => ({
      id: f.id,
      nome: f.nome_curto,
      semMedico: f.populacao?.percentagem_sem_medico ?? null,
      valores: Object.fromEntries(
        PERGUNTAS.map((q) => [q.id, f.indicadores[q.indicador]?.valor ?? null]),
      ),
    }))
    .sort((a, b) => a.nome.localeCompare(b.nome, "pt")),
}));

const medianas = Object.fromEntries(
  PERGUNTAS.map((q) => [q.id, nac[q.indicador]?.mediana_instituicoes ?? null]),
);
const unidades = Object.fromEntries(
  PERGUNTAS.map((q) => [q.id, nac[q.indicador]?.unidade ?? "percentagem"]),
);
const polaridades = Object.fromEntries(
  PERGUNTAS.map((q) => [q.id, nac[q.indicador]?.polaridade ?? "neutro"]),
);

/* Sem médico de família: a pergunta que não depende de escolher hospital. */
const semMdfNacional = todas.reduce(
  (acc, f) => {
    if (!f.populacao) return acc;
    acc.inscritos += f.populacao.inscritos;
    acc.sem += f.populacao.sem_medico_familia;
    return acc;
  },
  { inscritos: 0, sem: 0 },
);
---

<Base
  titulo="Perguntas"
  descricao="Respostas às perguntas que as pessoas fazem ao SNS: que maternidade, quanto se espera por uma cirurgia, quantos não têm médico de família — pelo seu distrito."
>
  <div>
    <header class="cab">
      <p class="sobretitulo">Perguntas</p>
      <h1>O que precisa de saber?</h1>
      <p class="cab__intro">
        As outras páginas deste sítio partem de um indicador. Esta parte de uma
        pergunta, e responde com as unidades do seu distrito — porque a escolha
        real é entre os hospitais que lhe ficam perto, não entre os 43 do país.
      </p>
      <div class="escolha">
        <label class="flabel" for="distrito">O meu distrito</label>
        <select id="distrito" data-distrito>
          {distritos.map((d) => <option value={d}>{d}</option>)}
        </select>
      </div>
    </header>

    <nav class="indice" aria-label="Nesta página">
      <p class="flabel">Nesta página</p>
      <ul>
        {PERGUNTAS.map((q) => <li><a href={`#${q.id}`}>{q.atalho}</a></li>)}
        <li><a href="#medico-de-familia">Médico de família</a></li>
      </ul>
    </nav>

    {
      PERGUNTAS.map((q) => (
        <section class="q" id={q.id} data-entrada>
          <h2><Icone nome={q.icone as any} tamanho={22} />{q.pergunta}</h2>
          <p class="q__explica">{q.explica}</p>
          <div class="q__resposta">
            {dados.map((d) => {
              const com = d.unidades.filter((u) => u.valores[q.id] !== null);
              return (
                <div class="q__distrito" data-distrito-bloco={d.distrito}>
                  <h3 class="q__rotulo">{d.distrito}</h3>
                  {com.length ? (
                    <ul class="rs">
                      {com.map((u) => {
                        const v = u.valores[q.id]!;
                        const med = medianas[q.id];
                        const pol = polaridades[q.id];
                        let cls = "neu", nota = "";
                        if (med !== null && pol !== "neutro") {
                          const melhor = pol === "subir_e_bom" ? v > med : v < med;
                          if (Math.abs(v - med) / (med || 1) >= 0.03) {
                            cls = melhor ? "pos" : "neg";
                            nota = melhor ? "melhor que a mediana" : "pior que a mediana";
                          } else nota = "em linha com a mediana";
                        } else if (med !== null) {
                          nota = `mediana nacional ${formatar(med, unidades[q.id])}`;
                        }
                        return (
                          <li class="r">
                            <span class="r__nome"><a href={ligacao(`/instituicao/${u.id}/`)}>{u.nome}</a></span>
                            <span class={`r__valor num ${cls}`}>{formatar(v, unidades[q.id])}</span>
                            <span class="r__nota">{nota}</span>
                          </li>
                        );
                      })}
                    </ul>
                  ) : (
                    <p class="q__vazio">Nenhuma unidade em {d.distrito} publica este indicador.</p>
                  )}
                </div>
              );
            })}
          </div>
          <p class="q__cautela">{q.cautela}</p>
        </section>
      ))
    }

    <section class="q" id="medico-de-familia">
      <h2><Icone nome="medico" tamanho={22} />Não tenho médico de família.</h2>
      <p class="q__explica">
        São <strong class="num">
          {new Intl.NumberFormat("pt-PT").format(semMdfNacional.sem)}
        </strong> pessoas em Portugal continental —{" "}
        <span class="num">
          {new Intl.NumberFormat("pt-PT", { maximumFractionDigits: 1 }).format(
            (100 * semMdfNacional.sem) / semMdfNacional.inscritos,
          )} %
        </span>{" "}
        de quem está inscrito nos cuidados de saúde primários. A proporção varia
        muito conforme a região.
      </p>
      <div class="q__resposta">
        {dados.map((d) => {
          const com = d.unidades.filter((u) => u.semMedico !== null);
          return (
            <div class="q__distrito" data-distrito-bloco={d.distrito}>
              <h3 class="q__rotulo">{d.distrito}</h3>
              {com.length ? (
                <ul class="rs">
                  {com.map((u) => (
                    <li class="r">
                      <span class="r__nome"><a href={ligacao(`/instituicao/${u.id}/`)}>{u.nome}</a></span>
                      <span class="r__valor num">{formatar(u.semMedico, "percentagem")}</span>
                      <span class="r__nota">sem médico de família atribuído</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="q__vazio">Sem dados de inscritos para {d.distrito}.</p>
              )}
            </div>
          );
        })}
      </div>
      <p class="q__cautela">
        Não ter médico de família atribuído não retira o direito a ser atendido:
        as unidades de saúde familiar mantêm consultas para utentes sem médico
        atribuído, e o SNS 24 continua disponível.
      </p>
    </section>
  </div>

  <script>
    /* O conteúdo de todos os distritos vem renderizado do servidor: sem
       JavaScript a página é longa mas completa e legível. Aqui apenas se
       escolhe qual mostrar. */
    const sel = document.querySelector<HTMLSelectElement>("[data-distrito]");
    const blocos = [...document.querySelectorAll<HTMLElement>("[data-distrito-bloco]")];

    function mostrar(distrito: string) {
      for (const b of blocos) b.hidden = b.dataset.distritoBloco !== distrito;
      const p = new URLSearchParams(location.hash.slice(1));
      p.set("d", distrito);
      history.replaceState(null, "", "#" + p.toString());
    }

    if (sel) {
      const pedido = new URLSearchParams(location.hash.slice(1)).get("d");
      const valido = pedido && blocos.some((b) => b.dataset.distritoBloco === pedido);
      if (valido) sel.value = pedido!;
      mostrar(sel.value);
      sel.addEventListener("change", () => mostrar(sel.value));
    }
  </script>
  <Movimento />
</Base>

{/* O SVG vem de dentro de Icone e o escopo desta página não lhe chega. */}
<style is:global>
  .q h2 .icone { display: inline-block; vertical-align: -0.16em; margin-right: 10px; color: var(--muted); }
</style>

<style>
  .cab { padding: 10px 0 0; }
  .cab__intro { font-size: var(--t-md); color: var(--ink-2); max-width: 78ch; margin-top: 10px; }
  .escolha { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--grid); }
  .escolha .flabel { display: block; margin-bottom: 6px; }
  .escolha select { font-size: var(--t-md); padding: 9px 12px; min-width: 14rem; }

  /* Menu de secções, como o «Nesta página» das fichas: esta era a única
     página de conteúdo sem forma de saltar entre as suas partes. */
  .indice { padding: 18px 0 0; margin-top: 16px; border-top: 1px solid var(--grid); }
  .indice .flabel { display: block; margin-bottom: 8px; }
  .indice ul { list-style: none; padding: 0; margin: 0; display: flex; gap: 8px; flex-wrap: wrap; }
  .indice a {
    font-size: var(--t-xs); text-decoration: none; color: var(--ink-2);
    border: 1px solid var(--baseline); border-radius: 999px; padding: 6px 12px;
    display: inline-block;
  }
  .indice a:hover { color: var(--ink); border-color: var(--ink-2); }

  .q { padding: 26px 0 0; margin-top: 20px; border-top: 1px solid var(--grid); scroll-margin-top: 56px; }
  .q h2 { font-size: clamp(19px, 3vw, 24px); }
  .q__explica { color: var(--ink-2); font-size: var(--t-sm); margin: 8px 0 14px; max-width: 78ch; }
  .q__cautela {
    font-size: var(--t-xs); color: var(--ink-2);
    border-left: 2px solid var(--warn); padding: 2px 0 2px 12px; margin: 14px 0 0; max-width: 90ch;
  }
  .q__vazio { color: var(--muted); font-size: var(--t-xs); }
  .q__rotulo {
    font-size: var(--t-3xs); font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--muted); margin: 18px 0 4px;
  }
  html.js .q__rotulo { display: none; }
  html.js .escolha { display: block; }
  .escolha { display: none; }

  .rs { list-style: none; margin: 0; padding: 0; }
  .r {
    display: grid; grid-template-columns: 1fr auto;
    grid-template-areas: "nome valor" "nota valor";
    gap: 0 16px; padding: 11px 0; border-bottom: 1px solid var(--grid); align-items: baseline;
  }
  .r__nome { grid-area: nome; font-weight: 600; font-size: var(--t-sm); }
  .r__nome a { color: inherit; text-decoration: none; }
  .r__nome a:hover { color: var(--accent); }
  .r__valor {
    grid-area: valor; font-size: var(--t-xl); font-weight: 750;
    letter-spacing: -0.02em; align-self: center;
  }
  .r__valor.pos { color: var(--pos-texto); }
  .r__valor.neg { color: var(--neg-texto); }
  .r__nota { grid-area: nota; font-size: var(--t-2xs); color: var(--muted); }
</style>
