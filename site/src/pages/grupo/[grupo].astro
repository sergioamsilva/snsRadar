---
/**
 * Uma página por grupo de comparação da ACSS.
 *
 * A ficha diz a que grupo uma unidade pertence e nomeia os seus pares. Faltava
 * o inverso: entrar pelo grupo e ver as unidades juntas. É a diferença entre
 * *saber* que existe um cluster e poder *navegar* por ele — e sem isso a
 * comparação entre pares só existia dentro de uma ficha de cada vez.
 *
 * A página responde a duas perguntas:
 *
 *   · **quem está aqui** — as unidades do grupo, com a região e o distrito, para
 *     se ver que o critério da ACSS é de custo e não de geografia: o Grupo C
 *     junta unidades de todo o país;
 *   · **onde está este grupo face ao país** — a mediana do grupo ao lado da
 *     mediana nacional, indicador a indicador. É aqui que se percebe que
 *     comparar tudo com tudo apaga informação: há grupos inteiros
 *     sistematicamente acima ou abaixo do país.
 */
import Base from "../../layouts/Base.astro";
import Mapa from "../../components/Mapa.astro";
import Movimento from "../../components/Movimento.astro";
import Multiplos from "../../components/Multiplos.astro";
import { ficha, indice, nacional, formatar, ligacao } from "../../lib/dados";

export function getStaticPaths() {
  const fichas = indice().map((i) => ficha(i.id));
  const grupos = [
    ...new Set(
      fichas.map((f) => f.grupo_comparacao?.grupo).filter((g): g is string => !!g),
    ),
  ].sort();
  return grupos.map((g) => ({
    // «Grupo C» → «c», que é o que se escreve num endereço.
    params: { grupo: g.replace(/^Grupo\s+/i, "").toLowerCase() },
    props: { nomeGrupo: g },
  }));
}

const { nomeGrupo } = Astro.props;
const nac = nacional();
const todas = indice().map((i) => ficha(i.id));
const membros = todas
  .filter((f) => f.grupo_comparacao?.grupo === nomeGrupo)
  .sort((a, b) => a.nome_curto.localeCompare(b.nome_curto, "pt"));

/* Os grupos que existem, derivados dos dados — a mesma regra de
   getStaticPaths. A primeira versão escrevia ["B", …, "F"] à mão na navegação:
   um grupo novo ganhava página mas ninguém chegava lá. */
const grupos = [
  ...new Set(
    todas.map((f) => f.grupo_comparacao?.grupo).filter((g): g is string => !!g),
  ),
].sort();

const definicao = membros[0]?.grupo_comparacao?.definicao ?? null;
const fonte = membros[0]?.grupo_comparacao?.fonte ?? null;

/* Onde este grupo se afasta do país. Só entram os indicadores em que a ACSS
   tem mediana de grupo — o que exige cinco unidades com valor, e é a mesma
   regra da ficha. Ordenados pelo tamanho do desvio, porque é isso que
   responde à pergunta «este grupo é diferente do país em quê?». */
const contraste = Object.entries(nac)
  .map(([iid, n]) => {
    const g = n.mediana_por_grupo?.[nomeGrupo];
    if (!g || n.mediana_instituicoes === null) return null;
    const desvio =
      n.mediana_instituicoes === 0
        ? 0
        : (g.mediana - n.mediana_instituicoes) / Math.abs(n.mediana_instituicoes);
    return {
      iid,
      titulo: n.titulo,
      unidade: n.unidade,
      polaridade: n.polaridade,
      grupo: g.mediana,
      nacional: n.mediana_instituicoes,
      n: g.n_instituicoes,
      desvio,
    };
  })
  .filter((x): x is NonNullable<typeof x> => x !== null)
  .sort((a, b) => Math.abs(b.desvio) - Math.abs(a.desvio));

const regioes = [...new Set(membros.map((m) => m.regiao))].sort();
const distritos = [...new Set(membros.map((m) => m.distrito))];
const populacao = membros.reduce((s, m) => s + (m.populacao?.inscritos ?? 0), 0);
const acima = contraste.filter((c) => c.desvio > 0.1).length;
const abaixo = contraste.filter((c) => c.desvio < -0.1).length;

/* Small multiples: as unidades do grupo na mesma escala, para os indicadores
   em que a dinâmica interessa e (quase) todas publicam. As barras de desvio
   comparam um instante; isto responde a «o grupo mexe-se junto, ou há unidades
   a descolar?». Só entram indicadores com cinco ou mais unidades com série —
   a mesma regra das medianas de grupo. */
const ESCOLHA_MULT = [
  { iid: "ocupacao-internamento", rotulo: "Ocupação" },
  { iid: "lic-dentro-tmrg", rotulo: "Cirurgia no prazo" },
  { iid: "prazo-medio-pagamento", rotulo: "Prazo de pagamento" },
  { iid: "urgencia-prioritarios", rotulo: "Urgências prioritárias" },
];
const JANELA_MULT = 24;

const multiplos = ESCOLHA_MULT.map(({ iid, rotulo }) => {
  const meta = nac[iid];
  if (!meta) return null;
  const comSerie = membros
    .map((m) => ({
      m,
      serie: (m.indicadores[iid]?.serie ?? []).filter((p) => p.valor !== null),
    }))
    .filter((x) => x.serie.length >= 12);
  if (comSerie.length < 5) return null;
  const meses = [...new Set(comSerie.flatMap((x) => x.serie.map((p) => p.mes)))]
    .sort()
    .slice(-JANELA_MULT);
  const dentro = new Set(meses);
  const itens = comSerie
    .map(({ m, serie }) => ({
      id: m.id,
      nome: m.nome_curto,
      href: ligacao(`/instituicao/${m.id}/`),
      pontos: serie
        .filter((p) => dentro.has(p.mes))
        .map((p) => ({ mes: p.mes, valor: p.valor as number })),
    }))
    .filter((i) => i.pontos.length >= Math.min(12, meses.length - 2));
  if (itens.length < 5) return null;
  const mediana = meses
    .map((mes) => {
      const vals = itens
        .map((i) => i.pontos.find((p) => p.mes === mes)?.valor)
        .filter((v): v is number => v !== undefined)
        .sort((a, b) => a - b);
      return vals.length >= 5
        ? { mes, valor: vals[Math.floor(vals.length / 2)] }
        : null;
    })
    .filter((x): x is { mes: string; valor: number } => x !== null);
  return { iid, rotulo, titulo: meta.titulo, unidade: meta.unidade, itens, meses, mediana };
}).filter((x): x is NonNullable<typeof x> => x !== null);

/* A assinatura desta página é o mapa, e o que ela tem de dizer em três
   segundos é isto: um grupo da ACSS não tem forma geográfica. O Grupo C acende
   Cascais e o Alto Minho ao mesmo tempo. As barras de desvio vêm a seguir,
   porque respondem à pergunta que o mapa levanta — se não é geografia, é o
   quê? */
const maiorDesvio = Math.max(...contraste.map((c) => Math.abs(c.desvio)), 0.01);
const barras = contraste.slice(0, 12);
const pc = new Intl.NumberFormat("pt-PT", { maximumFractionDigits: 0 });
const descricao =
  `As ${membros.length} unidades do ${nomeGrupo} do benchmarking da ACSS, ` +
  `e como o grupo se compara com o conjunto do país.`;
---

<Base titulo={nomeGrupo} descricao={descricao}>
  <div class="pagina">
    <nav class="migalhas" aria-label="Percurso">
      <a href={ligacao("/instituicoes/")}>Instituições</a>
      <span aria-hidden="true">›</span>
      <a href={ligacao("/grupo/")}>Grupos de comparação</a>
    </nav>

    <header class="topo">
      <p class="sobretitulo">Grupo de comparação da ACSS</p>
      <h1>{nomeGrupo}</h1>
      <p class="topo__intro">
        <strong class="num">{membros.length}</strong> unidades, de{" "}
        <strong class="num">{regioes.length}</strong>{" "}
        {regioes.length === 1 ? "região" : "regiões"} do país. Comparam-se entre
        si porque se parecem no que custam, não no sítio onde ficam.
      </p>
      {definicao && (
        <p class="topo__nota">
          {definicao}{" "}
          {fonte && (
            <a href={fonte} rel="nofollow noopener">Benchmarking Hospitalar da ACSS</a>
          )}
        </p>
      )}
    </header>

    {/* Fila editorial de estatísticas: filetes finos, números que contam ao
        entrar, algarismos tabulares. É a forma que o resto do portal já usa —
        aqui serve para dar peso ao que a página afirma no título. */}
    <dl class="stats">
      <div>
        <dt>Unidades</dt>
        <dd class="num" data-contar={membros.length}>{membros.length}</dd>
      </div>
      <div>
        <dt>Distritos</dt>
        <dd class="num" data-contar={distritos.length}>{distritos.length}</dd>
      </div>
      {populacao > 0 && (
        <div>
          <dt>População</dt>
          {/* Compacto de propósito: «4 031 850» a 2,4rem atravessava a célula
              seguinte e escrevia por cima do número dela. */}
          <dd class="num">
            {new Intl.NumberFormat("pt-PT", {
              notation: "compact",
              maximumFractionDigits: 2,
            }).format(populacao)}
          </dd>
        </div>
      )}
      <div>
        <dt>Acima do país</dt>
        <dd class="num" data-contar={acima}>{acima}</dd>
      </div>
      <div>
        <dt>Abaixo do país</dt>
        <dd class="num" data-contar={abaixo}>{abaixo}</dd>
      </div>
    </dl>

    {/* A assinatura. Um grupo da ACSS não tem forma geográfica, e nenhuma frase
        diz isso tão depressa como ver Cascais e o Alto Minho acesos ao mesmo
        tempo. As restantes unidades ficam no mapa, apagadas: sem elas o país
        deixava de se reconhecer e a comparação perdia o termo. */}
    <div class="duo">
    <figure class="assinatura" data-entrada>
      <Mapa contorno destaques={membros.map((m) => m.id)} />
      <figcaption>
        As {membros.length} unidades do {nomeGrupo}, acesas no país. Espalham-se
        por {distritos.length} distritos e {regioes.length}{" "}
        {regioes.length === 1 ? "região" : "regiões"} — o que as junta é o custo,
        não a distância.
      </figcaption>
    </figure>

    <section class="bloco bloco--unidades">
      <div class="sec-band">
        <h2>As unidades deste grupo</h2><span class="ln" />
        <span class="n">{membros.length}</span>
      </div>
      <ul class="membros">
        {membros.map((m) => (
          <li>
            <a href={ligacao(`/instituicao/${m.id}/`)}>
              <span class="membros__nome">{m.nome_curto}</span>
              <span class="membros__meta">
                {m.distrito}<span aria-hidden="true"> · </span>{m.regiao}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    </div>

    <section class="bloco">
      <div class="sec-band">
        <h2>Onde este grupo se afasta do país</h2><span class="ln" />
        <span class="n">{contraste.length} indicadores</span>
      </div>
      <p class="bloco__intro">
        A mediana deste grupo ao lado da mediana de todas as unidades. Quando um
        grupo inteiro está sistematicamente acima ou abaixo do país, comparar as
        suas unidades com a mediana nacional diz mais sobre o grupo a que
        pertencem do que sobre elas.
      </p>
      {/* Barras de desvio face ao país. Uma só cor: o comprimento carrega a
          magnitude e o lado carrega o sinal. Colorir os dois lados de verde e
          vermelho seria afirmar que estar acima é mau — e depende do indicador,
          porque metade destes sobe-e-é-bom e a outra metade sobe-e-é-mau. */}
      <ul class="desvios" data-entrada>
        {barras.map((c) => {
          const larg = (Math.abs(c.desvio) / maiorDesvio) * 50;
          return (
            <li class="desvio">
              <span class="desvio__nome">{c.titulo}</span>
              <span class="desvio__pista">
                <span class="desvio__eixo" aria-hidden="true" />
                <span
                  class={`desvio__barra desvio__barra--${c.desvio >= 0 ? "acima" : "abaixo"}`}
                  style={`--larg:${larg}%`}
                />
              </span>
              <span class="desvio__valor num">
                {c.desvio > 0 ? "+" : ""}{pc.format(100 * c.desvio)} %
              </span>
            </li>
          );
        })}
      </ul>
      <p class="desvios__eixo-rot">
        <span>← abaixo do país</span><span>mediana nacional</span><span>acima do país →</span>
      </p>

      <details class="detalhe">
        <summary>Ver os valores, indicador a indicador</summary>
      <div
        class="tabela-caixa"
        tabindex="0"
        role="region"
        aria-label={`Mediana do ${nomeGrupo} face à mediana nacional, por indicador`}
      >
        <table class="contraste">
          <thead>
            <tr>
              <th scope="col">Indicador</th>
              <th scope="col" class="num">{nomeGrupo}</th>
              <th scope="col" class="num">País</th>
              <th scope="col" class="num">Desvio</th>
            </tr>
          </thead>
          <tbody>
            {/* Todos, não os primeiros vinte: a tabela já vive dentro de um
                <details>, que é a guarda contra o peso — truncar dentro dela
                escondia um terço dos indicadores sem dizer que faltavam. */}
            {contraste.map((c) => (
              <tr>
                {/* Sem ligação: a primeira versão apontava para a ficha do
                    primeiro membro por ordem alfabética, e lia-se como se a
                    mediana do grupo fosse o valor dessa unidade. */}
                <td>{c.titulo}</td>
                <td class="num">{formatar(c.grupo, c.unidade)}</td>
                <td class="num">{formatar(c.nacional, c.unidade)}</td>
                <td class="num">
                  {c.desvio > 0 ? "+" : ""}{pc.format(100 * c.desvio)} %
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      </details>
      <p class="bloco__nota">
        Só entram os indicadores em que o grupo tem cinco ou mais unidades com
        valor. Abaixo disso a mediana seria feita de duas ou três unidades, e
        cada uma pesaria demasiado na régua contra a qual as outras são lidas.
      </p>
    </section>

    {multiplos.length > 0 && (
      <section class="bloco" data-entrada>
        <div class="sec-band">
          <h2>Cada unidade, a mesma escala</h2><span class="ln" />
          <span class="n">últimos {JANELA_MULT} meses</span>
        </div>
        <p class="bloco__intro">
          As barras acima comparam um instante; estas miniaturas comparam a
          dinâmica. Todas partilham o mesmo eixo — é isso que permite varrê-las
          com os olhos e ver se o grupo se move junto ou se há unidades a
          descolar.
        </p>
        {multiplos.length > 1 && (
          <div class="mult-chips" role="group" aria-label="Escolher o indicador das miniaturas">
            {multiplos.map((m, i) => (
              <button
                class="chip"
                type="button"
                data-mult={m.iid}
                aria-pressed={i === 0 ? "true" : "false"}
              >
                {m.rotulo}
              </button>
            ))}
          </div>
        )}
        {multiplos.map((m, i) => (
          <div class="mult-bloco" data-mult-bloco={m.iid} data-primeiro={i === 0 ? "" : undefined}>
            <h3 class="mult-titulo">{m.titulo}</h3>
            <Multiplos itens={m.itens} unidade={m.unidade} meses={m.meses} mediana={m.mediana} />
          </div>
        ))}
      </section>
    )}

    <nav class="outros" aria-label="Outros grupos">
      <p class="flabel">Outros grupos</p>
      <ul>
        {grupos.map((g) => (
          <li>
            <a
              href={ligacao(`/grupo/${g.replace(/^Grupo\s+/i, "").toLowerCase()}/`)}
              aria-current={g === nomeGrupo ? "page" : undefined}
            >
              {g}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <Movimento />
</Base>

<script>
  /* Um indicador de cada vez nas miniaturas. Sem JavaScript mostram-se todos,
     por ordem, com o seu título — a página fica longa mas completa. */
  const chips = [...document.querySelectorAll<HTMLButtonElement>("[data-mult]")];
  const blocos = [...document.querySelectorAll<HTMLElement>("[data-mult-bloco]")];
  if (chips.length && blocos.length) {
    const mostrar = (iid: string) => {
      for (const b of blocos) b.hidden = b.dataset.multBloco !== iid;
      for (const c of chips)
        c.setAttribute("aria-pressed", String(c.dataset.mult === iid));
    };
    for (const c of chips)
      c.addEventListener("click", () => mostrar(c.dataset.mult!));
    mostrar(blocos[0].dataset.multBloco!);
  }
</script>

<style>
  /* Largura total com goteira, como o resto do portal (`.wrap` em global.css).
     A primeira versão prendia a página a 54rem e num ecrã de 1400 px o mapa
     ficava do tamanho de um selo com dois terços do ecrã vazios. A medida de
     leitura aplica-se à prosa, não ao conteúdo todo. */
  .pagina { padding: 0 var(--gutter, 20px) 64px; }
  .migalhas {
    font-size: var(--t-2xs); color: var(--muted); margin: 24px 0 8px;
    display: flex; gap: 8px; align-items: center;
  }
  /* WCAG 2.2 pede 24×24 px de alvo; a migalha tinha 20 de altura. */
  .migalhas a { display: inline-flex; align-items: center; min-height: 24px; }
  .topo { margin-bottom: 32px; }
  .topo h1 { margin: 4px 0 12px; }
  .topo__intro { font-size: var(--t-md); max-width: 62ch; }
  .topo__nota { margin-top: 10px; font-size: var(--t-2xs); color: var(--muted); max-width: 78ch; }

  /* Fila de estatísticas: filetes hairline, régua de acento que cresce no
     hover, algarismos tabulares. Um gesto por elemento. */
  .stats {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    column-gap: 16px;
    gap: 0; margin: 28px 0 8px; border-top: 1px solid var(--border);
  }
  /* O espaçamento é por padding e não só por `column-gap`: a 390 px os rótulos
     de duas células vizinhas colavam-se e liam-se como uma palavra só —
     «POPULAÇÃO SERVIDAACIMA DO PAÍS». */
  .stats > div {
    padding: 14px 16px 12px 0; border-bottom: 1px solid var(--border);
    position: relative;
  }
  .stats > div::after {
    content: ""; position: absolute; left: 0; bottom: -1px; height: 2px; width: 0;
    max-width: calc(100% - 16px);
    background: var(--accent); transition: width 0.5s cubic-bezier(0.22, 0.8, 0.25, 1);
  }
  .stats > div:hover::after { width: 2.5rem; }
  .stats dt {
    font-size: var(--t-3xs); letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--muted); font-weight: 700;
  }
  .stats dd {
    margin: 4px 0 0; font-size: clamp(1.5rem, 3.4vw, 2.1rem); font-weight: 700;
    line-height: 1.05; font-variant-numeric: tabular-nums;
  }

  .assinatura { margin: 8px 0 32px; }
  .assinatura figcaption {
    font-size: var(--t-xs); color: var(--ink-2); margin-top: 8px; max-width: 46ch;
  }

  /* Duas colunas onde há largura: o mapa é a figura e a lista é a legenda dele.
     Abaixo disso empilham, e o mapa fica primeiro — é ele que explica. */
  .duo { display: grid; gap: 8px clamp(28px, 4vw, 72px); align-items: start; }
  @media (min-width: 62rem) {
    .duo { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); }
    .bloco--unidades { margin-top: 8px; }
    /* O mapa é limitado pela altura (62vh no componente), não pela largura:
       numa coluna larga sobrava-lhe espaço dos dois lados. Aqui, onde ele é a
       figura principal da página, pode crescer. */
    .assinatura :global(.mapa__svg) { max-height: 82vh; }
  }

  /* Barras de desvio: o eixo é o país, a barra cresce para o lado do sinal. */
  .desvios { list-style: none; margin: 16px 0 4px; padding: 0; display: grid; gap: 6px; }
  .desvio {
    display: grid; grid-template-columns: minmax(0, 17rem) 1fr 3.6rem;
    align-items: center; gap: 12px; font-size: var(--t-3xs); color: var(--ink-2);
  }
  @media (min-width: 75rem) { .desvio { grid-template-columns: minmax(0, 24rem) 1fr 4rem; } }
  @media (max-width: 48rem) { .desvio { grid-template-columns: minmax(0, 11rem) 1fr 3.4rem; } }
  @media (max-width: 34rem) { .desvio { grid-template-columns: minmax(0, 7.5rem) 1fr 3.2rem; } }
  .desvio__nome { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .desvio__pista { position: relative; height: 14px; display: block; }
  .desvio__eixo {
    /* O eixo é a mediana nacional e é a referência de toda a leitura: tem de
       se ver sem competir com as barras. */
    position: absolute; left: 50%; top: -2px; bottom: -2px; width: 1px;
    background: var(--ink-2); opacity: 0.45;
  }
  .desvio__barra {
    position: absolute; top: 3px; height: 8px; width: var(--larg);
    background: var(--ink-2); opacity: 0.55;
    transform: scaleX(1); transform-origin: left center;
  }
  .desvio__barra--acima { left: 50%; border-radius: 0 4px 4px 0; }
  .desvio__barra--abaixo { right: 50%; border-radius: 4px 0 0 4px; transform-origin: right center; }
  /* O gesto do projeto é `[data-entrada]` + `.entrou`, posto por
     Movimento.astro. Na primeira versão inventei `[data-visivel]`, que não
     existe — e as barras ficavam em scaleX(0) para sempre, invisíveis. */
  html.js [data-entrada] .desvio__barra { transform: scaleX(0); }
  html.js [data-entrada].entrou .desvio__barra {
    transform: scaleX(1);
    transition: transform 0.7s cubic-bezier(0.22, 0.8, 0.25, 1) var(--atraso, 0ms);
  }
  @media (prefers-reduced-motion: reduce) {
    html.js [data-entrada] .desvio__barra { transform: scaleX(1); transition: none; }
  }
  .desvio__valor { text-align: right; font-variant-numeric: tabular-nums; }
  .desvios__eixo-rot {
    display: flex; justify-content: space-between; margin: 0 0 12px;
    font-size: var(--t-3xs); color: var(--muted);
  }
