---
import fs from "node:fs";
import path from "node:path";
import Base from "../layouts/Base.astro";
import {
  reforma as dadosReforma,
  indice,
  nacional,
  enriquecimento,
  formatarMesPorExtenso,
  formatarData,
  ligacao,
} from "../lib/dados";
import Icone from "../components/Icone.astro";

const n = indice().length;
const reforma = dadosReforma();

/* O dumbbell da reforma: para cada taxa, dois pontos no mesmo eixo — a
   variação das 32 transformadas e a das 7 que já eram ULS — ligados por um
   traço. É a mesma informação da tabela, mas a pergunta «mexeram-se juntas ou
   separaram-se?» responde-se com o comprimento do traço, sem ler números. As
   contagens ficam de fora, como na tabela: variação de perímetro não é
   desempenho. A cor segue o grupo (quem é quem), nunca o veredito. */
const taxasReforma = reforma.por_indicador.filter((x) => !x.mecanico);
const halteres = [...taxasReforma]
  .sort((a, b) => Math.abs(b.diferenca) - Math.abs(a.diferenca))
  .slice(0, 10);
const valoresR = halteres.flatMap((x) => [x.variacao_transformadas, x.variacao_controlo]);
let minR = Math.min(...valoresR, 0);
let maxR = Math.max(...valoresR, 0);
const folgaR = (maxR - minR) * 0.08 || 1;
minR -= folgaR;
maxR += folgaR;
const posR = (v: number) => ((v - minR) / (maxR - minR)) * 100;
const nfR = new Intl.NumberFormat("pt-PT", { maximumFractionDigits: 1 });
const sinalR = (v: number) => `${v > 0 ? "+" : ""}${nfR.format(v)} %`;
const sinalPp = (v: number) => `${v > 0 ? "+" : ""}${nfR.format(v)} pp`;
const nac = nacional();
const indicadores = Object.keys(nac).length;

const REPOSITORIO = "https://github.com/sergioamsilva/snsRadar";

/* ── atualidade dos dados ────────────────────────────────────────────────────
   Nenhuma destas datas é escrita à mão. Saem dos ficheiros que o pipeline
   produziu, por isso não podem ficar velhas sem que os dados também tenham
   ficado — que é o defeito de qualquer «última atualização» mantida à mão. */
const RAIZ_DADOS = path.resolve(process.cwd(), "..", "data");

const manifesto = JSON.parse(
  fs.readFileSync(path.join(RAIZ_DADOS, "snapshots", "manifesto-atual.json"), "utf-8"),
) as { capturado_em: string; datasets: Record<string, unknown> };
const extracao = formatarData(manifesto.capturado_em.slice(0, 10));
const conjuntosEspelhados = Object.keys(manifesto.datasets).length;
const conjuntosCatalogo = Object.keys(
  JSON.parse(fs.readFileSync(path.join(RAIZ_DADOS, "raw", "_catalogo.json"), "utf-8")),
).length;

const enr = enriquecimento() as any;
const mesesSerie = [
  ...new Set(Object.values(nac).flatMap((i: any) => (i.faixa ?? []).map((f: any) => f.mes))),
].sort();
const janela = Object.values(nac).find((i: any) => i.janela)?.janela ?? null;
const mortalidade = enr.mortalidade_ajustada?.meses_usados ?? [];
const contratos = Object.values(enr.contratos ?? {})[0] as any;
const anoEuropa = (() => {
  const eu = JSON.parse(
    fs.readFileSync(path.join(RAIZ_DADOS, "out", "europa.json"), "utf-8"),
  ) as Record<string, { ano?: string }>;
  return Object.values(eu)[0]?.ano ?? null;
})();

const de = (a: string, b: string) =>
  `${formatarMesPorExtenso(a)} a ${formatarMesPorExtenso(b)}`;

const CAMADAS: { camada: string; cobertura: string; nota: string }[] = [
  {
    camada: "Séries mensais",
    cobertura: mesesSerie.length
      ? de(mesesSerie[0] as string, mesesSerie[mesesSerie.length - 1] as string)
      : "—",
    nota: "o gráfico de cada indicador",
  },
  {
    camada: "Valor grande de cada indicador",
    cobertura: janela ? `12 meses até ${formatarMesPorExtenso(janela.a)}` : "—",
    nota: "a janela que produz o número em destaque",
  },
  {
    camada: "Triagem das urgências",
    cobertura: enr.triagem_nacional?.periodo
      ? de(...(enr.triagem_nacional.periodo.split(" a ") as [string, string]))
      : "—",
    nota: "a banda de cores da página inicial",
  },
  {
    camada: "População servida",
    cobertura: enr.populacao?.periodo ? formatarMesPorExtenso(enr.populacao.periodo) : "—",
    nota: "o denominador das taxas por mil habitantes",
  },
  {
    camada: "Contratos públicos",
    cobertura: contratos ? `${contratos.desde} a ${contratos.ate}` : "—",
    nota: "registo do IMPIC, atualizado ao dia",
  },
  {
    camada: "Mortalidade ajustada ao risco",
    cobertura: mortalidade.length
      ? de(mortalidade[0], mortalidade[mortalidade.length - 1])
      : "—",
    nota: "depende do registo de morbilidade, que a fonte publica mais tarde",
  },
  {
    camada: "Contexto europeu",
    cobertura: anoEuropa ?? "—",
    nota: "Eurostat, que consolida os países com anos de desfasamento",
  },
];

/* Índice desta página. Os rótulos são curtos de propósito: na margem competem
   com o texto, e um índice que se lê a custo não serve de índice. */
/* A lista de literatura não é escrita aqui: sai do mesmo `indicadores.yaml`
   que alimenta as fichas. Uma bibliografia mantida à mão ao lado das citações
   dos cartões acabaria a divergir delas — e seria o portal a contradizer-se
   sobre aquilo em que se apoia. */
const comEvidencia = Object.entries(nac)
  .filter(([, i]: [string, any]) => (i.evidencia ?? []).length > 0)
  .map(([id, i]: [string, any]) => ({ id, titulo: i.titulo, evidencia: i.evidencia }));

/* A referência da OMS para as cesarianas vive noutro campo — é um limiar
   desenhado na escala, não uma afirmação da descrição —, mas para quem procura
   as fontes do portal é uma delas. */
const comReferencia = Object.entries(nac)
  .filter(([, i]: [string, any]) => i.referencia)
  .map(([id, i]: [string, any]) => ({ id, titulo: i.titulo, fonte: i.referencia.fonte }));

const SECCOES = [
  { id: "acumuladas", rotulo: "Séries acumuladas" },
  { id: "reforma", rotulo: "A reforma de 2024" },
  { id: "totais", rotulo: "Somar pelos totais" },
  { id: "nunca", rotulo: "O que nunca fazemos" },
  { id: "comparacao", rotulo: "Comparação e limites" },
  { id: "evidencia", rotulo: "O que sustenta as afirmações" },
  { id: "estado", rotulo: "Estado do projeto" },
  { id: "atualizacao", rotulo: "Atualização" },
  { id: "citar", rotulo: "Como citar" },
  { id: "alteracoes", rotulo: "O que mudou" },
  { id: "erros", rotulo: "Erros" },
];
---

<Base
  titulo="Metodologia"
  descricao="Como os números do snsRadar são calculados, e porque diferem de somar os ficheiros do portal do SNS."
>
  <div class="pagina">
    <div class="texto">
    <p class="sobretitulo">Metodologia</p>
    <h1>Porque é que estes números diferem da fonte</h1>

    <p class="destaque">
      Os dados são os do Portal da Transparência do SNS, sem alterações. O que
      muda é o tratamento. Três correções separam estes números dos que se
      obtêm somando os ficheiros — e sem elas os resultados são errados por
      margens grandes.
    </p>

    <h2 id="acumuladas"><Icone nome="camadas" tamanho={21} />1. As séries são acumuladas no ano, não mensais</h2>
    <p>
      A maior parte dos conjuntos de dados, incluindo os designados «evolução
      mensal», publica em cada mês o total acumulado desde janeiro — e não o
      valor daquele mês. A ULS de Coimbra aparece em 2025 com 394 partos em
      janeiro, 759 em fevereiro, 1160 em março.
    </p>
    <p>
      Quem somar os doze meses de <code>partos-e-cesarianas</code> obtém
      <strong>413 728 partos em 2024</strong>. Portugal tem cerca de 85 mil
      nascimentos por ano. O valor correto, depois de converter os acumulados
      em fluxos mensais, é <strong>64 505</strong> partos em hospitais do SNS.
    </p>
    <p class="nota">
      Nada nos metadados do portal indica que estas séries são acumuladas. É um
      erro fácil de cometer e difícil de detetar.
    </p>

    <h2 id="reforma"><Icone nome="fusao" tamanho={21} />2. A reforma de 2024 parte todas as séries</h2>
    <p>
      A 1 de janeiro de 2024, o Decreto-Lei n.º 102/2023 renomeou 32
      instituições, transformando centros hospitalares em Unidades Locais de
      Saúde. Nos dados, os nomes antigos desaparecem e surgem nomes novos: sem
      uma tabela de correspondência, nenhum gráfico atravessa essa data.
    </p>
    <p>
      Sete dessas mudanças foram fusões de várias entidades numa só. A ULS de
      Coimbra reúne o Centro Hospitalar e Universitário de Coimbra, o Hospital
      Arcebispo João Crisóstomo e o Centro de Medicina de Reabilitação Rovisco
      Pais. Para que a série não se parta, somamos as antecessoras — mas
      dizemo-lo em cada ficha, porque a organização de hoje não é a mesma de
      há dez anos.
    </p>
    <p>
      A correspondência foi construída à mão, verificada contra o texto do
      decreto-lei, e está publicada no repositório do projeto para que possa
      ser corrigida por quem encontre um erro.
    </p>

    {/* O crosswalk existe para atravessar 2024. Uma vez atravessado, permite
        uma pergunta que mais ninguém pode fazer com dados públicos — e que só é
        honesta com o grupo de controlo à vista. */}
    <h3 id="reforma-efeito">E mudou alguma coisa?</h3>
    <p>
      Atravessar a reforma permite compará-la consigo mesma. As{" "}
      <strong>{reforma.n_transformadas}</strong> entidades que passaram a ULS
      absorveram os cuidados de saúde primários da sua área; as{" "}
      <strong>{reforma.n_controlo}</strong> que <em>já eram</em> ULS —
      Alto Minho, Matosinhos, Nordeste, Guarda, Castelo Branco, Baixo Alentejo e
      Litoral Alentejano — não mudaram de perímetro. São o grupo de controlo:
      sem ele, qualquer variação entre 2023 e 2024 confundir-se-ia com o que
      aconteceu ao país inteiro no mesmo período.
    </p>
    <p>
      Doze meses antes contra doze meses depois, em {reforma.por_indicador.length}{" "}
      indicadores. As maiores diferenças estão nas <strong>contagens</strong>, e
      não querem dizer o que parecem: os médicos das entidades transformadas
      sobem{" "}
      {nfR.format(reforma.por_indicador.find((x) => x.indicador === "medicos")?.variacao_transformadas ?? 0)}{" "}
      % contra{" "}
      {nfR.format(reforma.por_indicador.find((x) => x.indicador === "medicos")?.variacao_controlo ?? 0)}{" "}
      % no controlo — não é contratação, é a ULS a passar a contar o pessoal dos
      centros de saúde que absorveu. Só as <strong>taxas</strong> admitem leitura
      de desempenho, porque nelas o numerador e o denominador crescem juntos.
    </p>
    {/* O antes/depois como figura: dois pontos por taxa, um traço entre eles.
        O comprimento do traço é a resposta — mexeram-se juntas ou não. */}
    <figure class="halteres-fig" data-entrada>
      <figcaption class="halteres-cap">
        Variação de cada taxa, doze meses antes contra doze depois de janeiro
        de 2024 — as dez com maior diferença entre os dois grupos
      </figcaption>
      <p class="halteres-legenda" aria-hidden="true">
        <span class="hleg hleg--t">transformadas em ULS ({reforma.n_transformadas})</span>
        <span class="hleg hleg--c">já eram ULS — controlo ({reforma.n_controlo})</span>
      </p>
      <ul class="halteres" aria-label="Variação por indicador, transformadas contra controlo">
        {halteres.map((x) => (
          <li class="haltere">
            <span class="haltere__nome">{x.titulo}</span>
            <span class="sr">
              transformadas {sinalR(x.variacao_transformadas)}, controlo{" "}
              {sinalR(x.variacao_controlo)}
            </span>
            <span class="haltere__pista" aria-hidden="true">
              <span class="haltere__eixo" />
              <span class="haltere__zero" style={`left:${posR(0).toFixed(2)}%`} />
              <span
                class="haltere__liga"
                style={`left:${Math.min(posR(x.variacao_transformadas), posR(x.variacao_controlo)).toFixed(2)}%;width:${Math.abs(posR(x.variacao_transformadas) - posR(x.variacao_controlo)).toFixed(2)}%`}
              />
              <span
                class="haltere__ponto haltere__ponto--t"
                style={`left:${posR(x.variacao_transformadas).toFixed(2)}%`}
                title={`Transformadas: ${sinalR(x.variacao_transformadas)}`}
              />
              <span
                class="haltere__ponto haltere__ponto--c"
                style={`left:${posR(x.variacao_controlo).toFixed(2)}%`}
                title={`Controlo: ${sinalR(x.variacao_controlo)}`}
              />
            </span>
            <span class="haltere__dif num">
              <strong>{sinalPp(x.diferenca)}</strong>
            </span>
          </li>
        ))}
      </ul>
      <p class="halteres-eixo-rot" aria-hidden="true">
        <span>← caiu</span><span>sem variação</span><span>subiu →</span>
      </p>
    </figure>

    <details class="detalhe-reforma">
      <summary>Ver os valores das {taxasReforma.length} taxas, em tabela</summary>
      {/* Conteúdo largo rola dentro do seu próprio contentor: a página nunca
          rola na horizontal, e a 390 px esta tabela transbordava 85 px. */}
      <div
        class="reforma-caixa"
        tabindex="0"
        role="region"
        aria-label="Variação de cada taxa: entidades transformadas e grupo de controlo"
      >
      <table class="reforma">
        <caption>
          Variação de cada taxa, doze meses antes e depois de janeiro de 2024
        </caption>
        <thead>
          <tr>
            <th scope="col">Indicador</th>
            <th scope="col" class="num">Transformadas</th>
            <th scope="col" class="num">Controlo</th>
            <th scope="col" class="num">Diferença</th>
          </tr>
        </thead>
        <tbody>
          {taxasReforma.map((x) => (
            <tr>
              <td>{x.titulo}</td>
              <td class="num">{sinalR(x.variacao_transformadas)}</td>
              <td class="num">{sinalR(x.variacao_controlo)}</td>
              <td class="num"><strong>{sinalPp(x.diferenca)}</strong></td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    </details>
    <p class="ressalva">
      <strong>Isto não prova que a reforma correu bem ou mal.</strong> São sete
      unidades de controlo, não houve aleatorização, e as que já eram ULS antes
      de 2024 não o eram por acaso: são, na maioria, do interior e de menor
      dimensão, e isso pode ele próprio explicar a diferença. Uma queda de 31,8 %
      nas úlceras de pressão do controlo tanto pode ser cuidado melhor como
      registo pior. É a leitura de conjunto que os dados públicos permitem, com
      os pressupostos à vista — não é um estudo.
    </p>

    <h2 id="totais"><Icone nome="divisao" tamanho={21} />3. As taxas somam-se pelos totais, nunca pelas percentagens</h2>
    <p>
      Uma taxa é sempre a soma dos numeradores a dividir pela soma dos
      denominadores. Fazer a média das percentagens mensais daria o mesmo peso
      a um mês com 12 partos e a um mês com 1200 — e produziria um número que
      não corresponde a doente nenhum.
    </p>

    <h2 id="nunca"><Icone nome="proibido" tamanho={21} />O que o site nunca faz</h2>
    <ul class="regras">
      <li>
        <Icone nome="cruz" tamanho={15} />
        <strong>Não mostra percentagens sem as contagens que as originam.</strong>
        Cada taxa vem acompanhada do «tantos em tantos».
      </li>
      <li>
        <Icone nome="cruz" tamanho={15} />
        <strong>Não calcula taxas sobre denominadores pequenos.</strong> Abaixo
        de 20 casos, uma percentagem é ruído: num mês com 8 partos, uma
        cesariana a mais move a taxa 12 pontos.
      </li>
      <li>
        <Icone nome="cruz" tamanho={15} />
        <strong>Não preenche lacunas.</strong> Um mês em falta fica em falta.
        Quando a conversão de acumulado para mensal não é fiável, não há valor.
      </li>
      <li>
        <Icone nome="cruz" tamanho={15} />
        <strong>Não lê como resultado o zero que é lacuna.</strong> Nos
        indicadores em que a fonte publica só a taxa, um mês por apurar sai
        como 0,0 %. Meia dúzia de zeros exatos seguidos, logo a seguir a meses
        que reportavam valores e ainda a durar, é falha de reporte: esses meses
        ficam de fora do valor, do gráfico e da mediana nacional, e a ficha diz
        quantos foram.
      </li>
      <li>
        <Icone nome="cruz" tamanho={15} />
        <strong>Não ordena hospitais do melhor para o pior.</strong> Estes
        indicadores não estão ajustados ao risco.
      </li>
      <li>
        <Icone nome="cruz" tamanho={15} />
        <strong>Não apresenta um número sem a sua proveniência.</strong> Cada
        valor liga à consulta da API do SNS que o reproduz.
      </li>
    </ul>

    <h2 id="comparacao"><Icone nome="balanca" tamanho={21} />A comparação que o site faz, e os seus limites</h2>
    <p>
      Cada indicador é comparado com a <strong>mediana das instituições</strong>,
      e não com a média — a mediana não é arrastada por um ou dois casos
      extremos. Onde existe uma referência externa reconhecida, como o intervalo
      da Organização Mundial da Saúde para cesarianas, ela aparece na escala.
    </p>
    <p>
      <strong>Uma referência não é uma meta.</strong> Os 10 a 15 % de cesarianas
      são um consenso de peritos de 1985 e são a única régua que o público
      conhece — por isso continuam na escala. Mas em 2015 a OMS deixou de fixar
      um alvo: concluiu que a taxa ideal é desconhecida e que, acima de 10 %,
      mais cesarianas não aparecem associadas a menos mortes de mães ou de
      recém-nascidos. A régua serve para situar um valor, não para dizer quem
      cumpre.
    </p>
    <p class="aviso">
      <strong>Um hospital com piores resultados não é, por isso, um pior
      hospital.</strong> Um serviço que recebe os doentes mais graves de uma
      região terá mais mortalidade e mais cesarianas do que um que os
      transfere. Estes dados não permitem distinguir as duas coisas. Servem
      para levantar perguntas, não para as responder.
    </p>

    <h2 id="evidencia"><Icone nome="livro" tamanho={21} />O que sustenta as afirmações do portal</h2>
    <p>
      Cada número liga à consulta da API que o reproduz. As frases que
      acompanham os números — que operar cedo uma fratura da anca está
      associado a menos mortes, que as fluoroquinolonas selecionam resistências
      — são afirmações sobre o mundo, e essas não se verificam numa API. Ficam
      aqui as fontes que as sustentam, as mesmas que aparecem no cartão de cada
      indicador.
    </p>
    <ul class="literatura">
      {comEvidencia.map((i) => (
        <li>
          <span class="literatura__ind">{i.titulo}</span>
          <ul>
            {i.evidencia.map((e: any) => (
              <li>
                <a href={e.url} rel="noopener" target="_blank">{e.citacao}</a>
                {e.nota && <span class="literatura__nota">{e.nota}</span>}
              </li>
            ))}
          </ul>
        </li>
      ))}
      <li>
        <span class="literatura__ind">Mortalidade ajustada ao risco</span>
        <ul>
          <li>
            <a href="https://doi.org/10.1136/bmj.c2016" rel="noopener" target="_blank">
              Lilford R. &amp; Pronovost P., «Using hospital mortality rates to
              judge hospital performance: a bad idea that just won't go away»,
              BMJ, 2010;340:c2016.
            </a>
            <span class="literatura__nota">
              A crítica de onde vem a regra deste portal: só se afirma diferença
              quando o intervalo de confiança não contém 1.
            </span>
          </li>
          <li>
            <a href="https://doi.org/10.1056/NEJMsa1006396" rel="noopener" target="_blank">
              Shahian D. M. et al., «Variability in the measurement of
              hospital-wide mortality rates», New England Journal of Medicine,
              2010;363:2530–9.
            </a>
          </li>
        </ul>
      </li>
      {comReferencia.map((i) => (
        <li>
          <span class="literatura__ind">{i.titulo}</span>
          <ul>
            <li>{i.fonte}</li>
          </ul>
        </li>
      ))}
    </ul>

    <h2 id="estado"><Icone nome="lista" tamanho={21} />Estado do projeto</h2>
    <p>
      {n} unidades de saúde, {indicadores} indicadores, séries mensais desde 2013 onde a
      fonte as publica. Os dados são reingeridos periodicamente e cada ingestão
      fica registada com uma impressão digital, para que se detete quando a
      fonte revê valores em silêncio.
    </p>

    <h2 id="atualizacao"><Icone nome="calendario" tamanho={21} />Atualização</h2>
    <p>
      Última extração de dados: <strong class="num">{extracao}</strong>. O
      catálogo do portal tem <span class="num">{conjuntosCatalogo}</span>{" "}
      conjuntos; destes, <span class="num">{conjuntosEspelhados}</span> são
      descarregados e guardados com a sua impressão digital, para que se detete
      quando a fonte revê valores sem mudar a data.
    </p>
    <p>
      As camadas não cobrem todas o mesmo período, porque as fontes não
      publicam ao mesmo ritmo. Apresentá-las como se fossem do mesmo dia seria
      enganador — <strong>a mortalidade ajustada ao risco é a que fica mais
      atrás</strong>, e é o único indicador desta página que permite comparar
      hospitais.
    </p>
    {/* Uma região que rola tem de poder receber foco, senão quem navega por
        teclado não lhe chega ao conteúdo cortado — é a regra
        `scrollable-region-focusable` do axe, e apanhou esta tabela mal ela
        passou a rolar. */}
    <div class="tabela" tabindex="0" role="region" aria-label="Cobertura de cada camada de dados">
      <table>
        <thead>
          <tr><th>Camada</th><th>Cobertura</th><th>Onde aparece</th></tr>
        </thead>
        <tbody>
          {CAMADAS.map((c) => (
            <tr>
              <td>{c.camada}</td>
