  }

  .detalhe-reforma { margin: 14px 0 16px; }
  /* Sem display:flex: o flex remove o triângulo do <summary>, e sem ele isto
     lê-se como uma linha de texto morta, não como algo que abre. */
  .detalhe-reforma summary {
    cursor: pointer; font-size: var(--t-xs); color: var(--ink-2);
    padding: 4px 0; min-height: 24px;
  }
  .detalhe-reforma summary:hover { color: var(--ink); }

  .reforma-caixa { overflow-x: auto; margin: 16px 0; }
  .reforma-caixa:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .reforma { width: 100%; min-width: 30rem; border-collapse: collapse; font-size: var(--t-xs); }
  .reforma caption { text-align: left; color: var(--muted); font-size: var(--t-2xs); padding-bottom: 8px; }
  .reforma th, .reforma td { padding: 6px 8px; border-bottom: 1px solid var(--border); text-align: left; }
  .reforma th.num, .reforma td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .reforma thead th { color: var(--ink-2); font-size: var(--t-2xs); font-weight: 700; }
  .ressalva {
    border-left: 2px solid var(--border); padding-left: 12px;
    color: var(--ink-2); font-size: var(--t-xs);
  }
</style>

<style>
  /* Tabela de cobertura: numa página de prosa, as três colunas precisam de
     poder rolar sozinhas em ecrã estreito — a alternativa era encolher os
     períodos até deixarem de se ler. */
  /* `overflow-x: auto` não chega: `.texto` é item de grelha e um item de
     grelha não encolhe abaixo do seu conteúdo sem `min-width: 0`. Sem isso a
     largura mínima da tabela empurrava a página inteira, e a 390 px o portal
     transbordava — o `verificar.mjs` apanhou-o. */
  .tabela { overflow-x: auto; max-width: 100%; margin: 14px 0 18px; }
  .tabela table { min-width: 30rem; }
  .tabela td { vertical-align: top; }
  .tabela .nota { color: var(--muted); font-size: var(--t-2xs); }

  .citacao {
    margin: 14px 0 16px;
    padding: 2px 0 2px 14px;
    border-left: 3px solid var(--accent);
    font-size: var(--t-sm);
    color: var(--ink-2);
    line-height: 1.55;
  }

  /* A coluna de leitura mantém a sua medida; a segunda coluna leva o índice.
     `minmax(0, 82ch)` e não `82ch` fixo: com a unidade rígida, uma janela
     estreita não conseguia encolher a prosa e a página transbordava. */
  .pagina {
    display: grid;
