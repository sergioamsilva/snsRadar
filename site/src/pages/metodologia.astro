          </li>
        ))}
      </ul>
    </nav>
  </div>
</Base>

<script>
  /* Scrollspy: marca no índice a secção que está a ser lida. Sem JavaScript o
     índice continua a ser um índice — só não acompanha. */
  const atalhos = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-atalho]")].map((a) => [
      a.dataset.atalho!,
      a,
    ]),
  );
  const seccoes = [...atalhos.keys()]
    .map((id) => document.getElementById(id))
    .filter((e): e is HTMLElement => e !== null);

  if (seccoes.length) {
    let atual: string | null = null;
    const marcar = () => {
      // A secção ativa é a última cujo título já passou a linha de leitura, a
      // um terço do ecrã. Escolher «a que está visível» faria o índice saltar
      // para trás e para a frente quando duas cabem no mesmo ecrã.
      const linha = window.innerHeight / 3;
      let candidata = seccoes[0].id;
      for (const s of seccoes) {
        if (s.getBoundingClientRect().top <= linha) candidata = s.id;
      }
      // No fim da página as últimas secções nunca chegam a cruzar a linha —
      // não há scroll que chegue para as lá pôr. Sem esta exceção o índice
      // ficava preso em «Comparação e limites» com «Erros» à vista.
      const fim = document.documentElement.scrollHeight - window.innerHeight;
      if (fim - window.scrollY < 4) candidata = seccoes[seccoes.length - 1].id;
      if (candidata === atual) return;
      if (atual) atalhos.get(atual)?.removeAttribute("aria-current");
      atalhos.get(candidata)?.setAttribute("aria-current", "true");
      atual = candidata;
    };
    marcar();
    addEventListener("scroll", marcar, { passive: true });
  }
</script>

{/* Os SVG saem de dentro do componente Icone e o estilo com escopo desta
    página não lhes chega — presos a um antecessor para não vazarem. */}
<style is:global>
  /* O ícone vai dentro do h2 para acompanhar o título quando este quebra de
     linha. `align-self: baseline` com um recuo alinha-o pelo texto e não pelo
     centro da caixa, que num título de duas linhas ficaria a meio do vazio. */
  .texto h2 .icone {
    display: inline-block;
    vertical-align: -0.16em;
    margin-right: 10px;
    color: var(--muted);
  }
  /* Nas regras, a cruz ocupa a coluna do marcador da lista. Mais pequena e mais
     apagada do que o ícone da secção, para não competir com ele. */
  .regras .icone {
    position: absolute;
    left: 0;
    top: 0.28em;
    color: var(--muted);
  }
  /* A tabela da reforma: números à direita, alinhados, e a diferença em
     destaque porque é a coluna que responde à pergunta. */
  /* Focável pelo teclado porque rola: quem navega sem rato tem de conseguir
     chegar ao conteúdo que está fora do ecrã. */
  /* ── o dumbbell da reforma ─────────────────────────────────────────────
     Dois pontos por taxa no mesmo eixo, ligados por um traço. A cor diz quem
     é quem (transformadas vs controlo), nunca melhor ou pior — a polaridade
     varia de indicador para indicador e o texto ao lado é que julga. */
  .halteres-fig { margin: 18px 0 8px; }
  .halteres-cap { font-size: var(--t-2xs); color: var(--muted); margin-bottom: 10px; }
  .halteres-legenda { display: flex; gap: 18px; flex-wrap: wrap; margin: 0 0 6px; font-size: var(--t-3xs); color: var(--muted); }
  .hleg { display: inline-flex; align-items: center; gap: 6px; }
  .hleg::before { content: ""; width: 9px; height: 9px; border-radius: 50%; }
  .hleg--t::before { background: var(--accent); }
  .hleg--c::before { background: var(--cat3); }
  .halteres { list-style: none; margin: 0; padding: 0; }
  .haltere {
    display: grid; grid-template-columns: minmax(11rem, 16rem) 1fr 5.5rem;
    gap: 14px; align-items: center; padding: 8px 0;
    border-bottom: 1px solid var(--grid);
  }
  .haltere__nome { font-size: var(--t-xs); line-height: 1.3; }
  .haltere__pista { position: relative; height: 18px; }
  .haltere__eixo {
    position: absolute; inset-inline: 0; top: 50%; height: 1px;
    background: var(--grid);
  }
  .haltere__zero {
    position: absolute; top: 1px; bottom: 1px; width: 1px;
    background: var(--baseline);
  }
  .haltere__liga {
    position: absolute; top: 50%; height: 3px; margin-top: -1.5px;
    background: var(--ink-2); opacity: 0.45; border-radius: 2px;
  }
  .haltere__ponto {
    position: absolute; top: 50%; width: 10px; height: 10px;
    margin: -5px 0 0 -5px; border-radius: 50%;
    /* Anel da cor da página: onde os dois pontos se pisam, continua a ver-se
       que são dois. */
    box-shadow: 0 0 0 2px var(--page);
  }
  .haltere__ponto--t { background: var(--accent); }
  .haltere__ponto--c { background: var(--cat3); }
  .haltere__dif { text-align: right; font-size: var(--t-xs); }
  .halteres-eixo-rot {
    display: flex; justify-content: space-between; gap: 12px;
    margin: 6px 0 0; font-size: var(--t-3xs); color: var(--muted);
  }
  @media (max-width: 34rem) {
    .haltere { grid-template-columns: 1fr 4.5rem; }
