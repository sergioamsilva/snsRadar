---
/**
 * Portugal na Europa: uma linha, 29 países, um facto.
 *
 * Todo o resto deste portal compara Portugal com Portugal. Quem lê «33 % de
 * cesarianas» tem como única referência os 10 a 15 % da OMS e não sabe se está
 * longe deles sozinho ou acompanhado.
 *
 * A resposta é o desenho: **a faixa da OMS está quase deserta**. Um único país
 * dos 29 com dados cai lá dentro — a Islândia, com 14,2 %, encostada ao bordo
 * de cima. Os outros 28 estão todos acima.
 *
 * **O que a faixa é, e não é.** Os 10 a 15 % são o consenso de 1985. Em 2015 a
 * OMS deixou de fixar um alvo: a taxa ideal é desconhecida, e o que se sabe é
 * que acima de 10 % subir não traz menos mortes. Por isso o desenho não diz que
 * 28 países «não cumprem» — diz onde está cada um em relação a uma régua antiga
 * que continua a ser a única que o público conhece.
 *
 * **Forma.** Um eixo, um ponto por país. Vinte e nove barras seriam uma parede;
 * a distribuição num eixo lê-se de uma vez e mostra onde Portugal cai *dentro*
 * dela, que é a pergunta. Rótulos só nos extremos e em Portugal — um nome em
 * cada ponto tornaria a linha ilegível.
 *
 * **Sem JavaScript** o desenho é o mesmo: é SVG estático. A lista completa vai
 * num `<details>`, que também serve de tabela para quem lê por leitor de ecrã.
 */
import fs from "node:fs";
import path from "node:path";

const CAMINHO = path.resolve(process.cwd(), "..", "data", "out", "europa.json");
const dados = fs.existsSync(CAMINHO)
  ? JSON.parse(fs.readFileSync(CAMINHO, "utf-8")).cesarianas
  : null;

/* A referência da Organização Mundial da Saúde, a mesma que a ficha usa: o
   intervalo de 1985, que a declaração de 2015 já não apresenta como alvo. */
const OMS = { de: 10, a: 15, ano: 1985, declaracao: 2015 };

const paises: { codigo: string; nome: string; valor: number }[] = dados?.paises ?? [];
const valores = paises.map((p) => p.valor);
const lo = Math.min(OMS.de, ...valores) - 2;
const hi = Math.max(...valores) + 3;
const x = (v: number) => ((v - lo) / (hi - lo)) * 100;

const pt = paises.find((p) => p.codigo === "PT");
const posicao = pt ? paises.indexOf(pt) + 1 : null;
const maior = paises[0];
const menor = paises[paises.length - 1];

/* Quem cai dentro da faixa e quem fica acima. Contado dos dados, não escrito
   à mão: a frase de leitura tem de continuar verdadeira quando o Eurostat
   publicar o ano seguinte. */
const dentro = paises.filter((p) => p.valor >= OMS.de && p.valor <= OMS.a);
const acima = paises.filter((p) => p.valor > OMS.a);
const naFaixa = new Set(dentro.map((p) => p.codigo));

/* Traduções dos nomes que o Eurostat devolve em inglês. Só os que aparecem
   rotulados no desenho — a lista completa fica como a fonte a publica. */
const PT_NOME: Record<string, string> = {
  Cyprus: "Chipre",
  Iceland: "Islândia",
  Portugal: "Portugal",
  Greece: "Grécia",
  Netherlands: "Países Baixos",
};
const nomePt = (n: string) => PT_NOME[n] ?? n;

/* «Só Islândia» não é português; «Portugal» com artigo também não. O artigo
   vive à parte do nome porque a tabela lista os países sem ele. */
const ARTIGO: Record<string, string> = { Islândia: "a", Grécia: "a", "Países Baixos": "os" };
const comArtigo = (n: string) => {
  const artigo = ARTIGO[nomePt(n)];
  return artigo ? `${artigo} ${nomePt(n)}` : nomePt(n);
};
const emPais = (n: string) => {
  const artigo = ARTIGO[nomePt(n)];
  const prep: Record<string, string> = { a: "na", o: "no", os: "nos", as: "nas" };
  return `${artigo ? prep[artigo] : "em"} ${nomePt(n)}`;
};

const nf = (n: number) =>
  new Intl.NumberFormat("pt-PT", { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(n);

/* A mesma contagem, dita por extenso para quem ouve o desenho. */
const resumoOms =
  dentro.length === 0
    ? `Nenhum país está dentro da faixa de referência da Organização Mundial da Saúde, de ${OMS.de} a ${OMS.a} por cento, fixada em ${OMS.ano}.`
    : `${acima.length} dos ${paises.length} países estão acima da faixa de referência da Organização Mundial da Saúde, de ${OMS.de} a ${OMS.a} por cento, fixada em ${OMS.ano}; ` +
      (dentro.length === 1
        ? `só ${comArtigo(dentro[0].nome)}, com ${nf(dentro[0].valor)} por cento, fica dentro dela.`
        : `${dentro.length} ficam dentro dela.`);
---

{
  dados && pt && (
    <section class="eu" aria-labelledby="eu-titulo">
      <div class="sec-band">
        <h2 id="eu-titulo">Portugal na Europa</h2>
        <span class="ln" />
        <span class="n">{dados.ano}</span>
      </div>

      <p class="eu__sub">
        Cesarianas em percentagem dos nascimentos, nos {paises.length} países
        europeus com dados. Portugal é o{" "}
        <strong class="num">{posicao}.º mais alto</strong>.
      </p>

      <figure class="eu__fig">
        <svg
          viewBox="0 0 100 22"
          preserveAspectRatio="none"
          class="eu__svg"
          role="img"
          aria-label={
            `Distribuição das taxas de cesarianas em ${paises.length} países europeus em ${dados.ano}: ` +
            `de ${nf(menor.valor)} por cento ${emPais(menor.nome)} a ${nf(maior.valor)} por cento ${emPais(maior.nome)}. ` +
            `Portugal tem ${nf(pt.valor)} por cento, o ${posicao}.º mais alto. ` +
            resumoOms
          }
        >
          {/* A faixa da OMS. Fica quase vazia, e é esse o ponto. */}
          <rect
            x={x(OMS.de)}
            y="3"
            width={x(OMS.a) - x(OMS.de)}
            height="10"
            class="eu__oms"
          />
          <line x1="0" x2="100" y1="8" y2="8" class="eu__eixo" vector-effect="non-scaling-stroke" />
          {paises.map((p) => (
            <circle
              cx={x(p.valor)}
              cy="8"
              r={p.codigo === "PT" ? 1.15 : naFaixa.has(p.codigo) ? 0.9 : 0.62}
              class={
                p.codigo === "PT" ? "eu__pt" : naFaixa.has(p.codigo) ? "eu__dentro" : "eu__pais"
              }
              vector-effect="non-scaling-stroke"
            />
          ))}
        </svg>

        {/* Os rótulos vão em HTML posicionado, não em <text> do SVG: com
            `preserveAspectRatio="none"` o texto esticaria com o eixo. */}
        <div class="eu__rotulos" aria-hidden="true">
          <span class="eu__rot eu__rot--oms" style={`left:${x((OMS.de + OMS.a) / 2)}%`}>
            OMS {OMS.ano} <span class="num">{OMS.de}–{OMS.a} %</span>
          </span>
          <span
            class={`eu__rot eu__rot--menor${naFaixa.has(menor.codigo) ? " eu__rot--faixa" : ""}`}
            style={`left:${x(menor.valor)}%`}
          >
            {nomePt(menor.nome)} <span class="num">{nf(menor.valor)} %</span>
          </span>
          <span class="eu__rot eu__rot--pt" style={`left:${x(pt.valor)}%`}>
            Portugal <span class="num">{nf(pt.valor)} %</span>
          </span>
          <span class="eu__rot eu__rot--maior" style={`left:${x(maior.valor)}%`}>
            {nomePt(maior.nome)} <span class="num">{nf(maior.valor)} %</span>
          </span>
        </div>
      </figure>

      <p class="eu__leitura">
        <strong>
          {acima.length} dos {paises.length} países europeus estão acima da faixa
          de referência da OMS.
        </strong>{" "}
        {dentro.length === 0 ? (
          <>A faixa dos {OMS.de} a {OMS.a} % fica vazia.</>
        ) : dentro.length === 1 ? (
          <>
            Só {comArtigo(dentro[0].nome)} fica dentro da faixa dos {OMS.de} a {OMS.a} %,
            com <span class="num">{nf(dentro[0].valor)} %</span> — encostada ao
            limite de cima.
          </>
        ) : (
          <>
            Apenas {dentro.length} ficam dentro da faixa dos {OMS.de} a {OMS.a} %; o
            mais baixo é {nomePt(menor.nome)}, com{" "}
            <span class="num">{nf(menor.valor)} %</span>.
          </>
        )}{" "}
        Portugal, com <span class="num">{nf(pt.valor)} %</span>, está a{" "}
        <span class="num">{nf(pt.valor / OMS.a)} vezes</span> esse limite.
      </p>

      <p class="eu__ressalva">
        <strong>A faixa não é uma meta.</strong> Os {OMS.de} a {OMS.a} % são um
        consenso de peritos de {OMS.ano}. Em {OMS.declaracao} a Organização
        Mundial da Saúde deixou de fixar um alvo: a taxa ideal é desconhecida e,
        acima de {OMS.de} %, mais cesarianas não aparecem associadas a menos
        mortes de mães ou de recém-nascidos. O que a OMS pede é que tenha
        cesariana quem precisa — não que se persiga uma percentagem.
      </p>

      <details class="eu__lista">
        <summary>Os {paises.length} países</summary>
        <table>
          <thead>
            <tr><th>País</th><th class="dir">Cesarianas</th></tr>
          </thead>
          <tbody>
            {paises.map((p) => (
              <tr class={p.codigo === "PT" ? "eu__linha-pt" : undefined}>
                <td>{nomePt(p.nome)}</td>
                <td class="dir num">{nf(p.valor)} %</td>
              </tr>
            ))}
          </tbody>
        </table>
      </details>

      <p class="eu__nota">
        {dados.nota} Fonte: <a href={dados.url} target="_blank" rel="noopener">{dados.fonte}</a>.
      </p>
    </section>
  )
}

<style>
  .eu { margin: 4px 0 0; }
  .eu__sub {
    margin: 10px 0 0;
    font-size: var(--t-sm);
    color: var(--ink-2);
    max-width: 78ch;
  }
  .eu__sub strong { color: var(--ink); font-weight: 750; }

  .eu__fig { margin: 22px 0 0; position: relative; }
  .eu__svg { width: 100%; height: 56px; display: block; overflow: visible; }
  .eu__eixo { stroke: var(--baseline); stroke-width: 1; }
  .eu__oms { fill: var(--accent); fill-opacity: 0.13; }
  .eu__pais {
    fill: var(--ink-2);
    fill-opacity: 0.55;
    stroke: var(--page);
    stroke-width: 0.6;
  }
  .eu__pt { fill: var(--accent); stroke: var(--page); stroke-width: 0.8; }
  /* Quem cumpre a recomendação. Um ponto só, mas o desenho tem de o distinguir
     dos 28 que estão fora — senão a faixa lê-se como vazia, e não está. */
  .eu__dentro { fill: var(--pos); stroke: var(--page); stroke-width: 0.7; }

  .eu__rotulos { position: relative; height: 42px; margin-top: -6px; }
  .eu__rot {
    position: absolute;
    font-size: var(--t-3xs);
    color: var(--muted);
    white-space: nowrap;
    transform: translateX(-50%);
  }
  .eu__rot .num { font-weight: 650; }
  /* Os extremos encostam-se ao bordo: centrá-los deitá-los-ia para fora. */
  .eu__rot--menor { transform: none; }
  .eu__rot--maior { transform: translateX(-100%); }
  .eu__rot--oms { top: 0; color: var(--accent-texto); }
  .eu__rot--menor,
  .eu__rot--maior { top: 20px; }
  .eu__rot--faixa { color: var(--pos-texto); }
  .eu__rot--pt {
    top: 20px;
    color: var(--ink);
    font-weight: 700;
  }

  .eu__leitura {
    margin: 16px 0 0;
    font-size: var(--t-sm);
    color: var(--ink-2);
    max-width: 78ch;
  }
  .eu__leitura strong { color: var(--ink); font-weight: 750; }

  /* A ressalva vive um degrau abaixo da leitura: quem passa os olhos fica com
     o facto, quem lê a sério fica a saber o que a régua vale. */
  .eu__ressalva {
    margin: 10px 0 0;
    font-size: var(--t-xs);
    color: var(--muted);
    max-width: 78ch;
  }
  .eu__ressalva strong { color: var(--ink-2); font-weight: 700; }

  .eu__lista { margin: 14px 0 0; font-size: var(--t-xs); }
  .eu__lista summary {
    cursor: pointer;
    color: var(--ink-2);
    padding: 4px 0;
  }
  .eu__lista table { margin-top: 8px; max-width: 32rem; }
  .eu__lista .dir { text-align: right; }
  .eu__linha-pt { font-weight: 700; }

  .eu__nota {
    margin: 14px 0 0;
    font-size: var(--t-2xs);
    color: var(--muted);
    max-width: 90ch;
  }

  @media (max-width: 640px) {
    /* Com quatro rótulos numa linha estreita, Portugal e o vizinho colidem;
       o de menor valor cai para baixo e o eixo continua a ler-se. */
    .eu__rotulos { height: 58px; }
    .eu__rot--menor { top: 36px; }
  }
</style>
